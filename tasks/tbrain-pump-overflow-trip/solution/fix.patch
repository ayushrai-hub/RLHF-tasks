+// State-machine modes for the per-line trip simulation.
+const (
+	smIdle = iota
+	smArming
+	smActive
+	smReseting
+)
+
+// sim is the per-line trip state machine over its (sample|maint)
+// timeline. A maint window freezes the arm/reset dwell and the over-time
+// budget clock; time spent frozen does not advance any of them.
+type sim struct {
+	limit, arm, reset, budget int
+	horizon                   int
+	mode                      int
+	frozen                    bool
+	haveLps                  bool
+	curLps                   int
+	curStart                  int
+	resetFrom                 int
+	remain                    int // non-frozen dwell seconds until the pending boundary; -1 = none
+	cum                       int
+	locked                   bool
+	lockedAt                 int
+	lastEnd                   int
+	excs                      []Trip
+}
+
+func (s *sim) over() bool { return s.haveLps && s.curLps > s.limit }
+
+func (s *sim) finalize(end int) {
+	if s.curStart < end {
+		s.excs = append(s.excs, Trip{Start: s.curStart, End: end})
+	}
+	s.lastEnd = end
+}
+
+func (s *sim) accrueTo(frm, to int) bool {
+	if s.locked || to <= frm {
+		return false
+	}
+	dur := to - frm
+	if s.cum+dur >= s.budget {
+		s.lockedAt = frm + (s.budget - s.cum)
+		s.cum = s.budget
+		s.locked = true
+		s.finalize(s.lockedAt)
+		return true
+	}
+	s.cum += dur
+	return false
+}
+
+func (s *sim) fireBoundary(b int) {
+	if s.mode == smArming {
+		if s.over() {
+			s.mode = smActive
+			s.remain = -1
+			if s.budget == 0 {
+				s.lockedAt = b
+				s.cum = 0
+				s.locked = true
+				s.finalize(b)
+			}
+		} else {
+			s.mode = smIdle
+			s.remain = -1
+		}
+	} else if s.mode == smReseting {
+		if !s.over() {
+			s.finalize(s.resetFrom)
+			s.mode = smIdle
+			s.remain = -1
+		} else {
+			s.remain = -1
+		}
+	}
+}
+
+func (s *sim) step(frm, to int) {
+	for frm < to && !s.locked {
+		nxt := to
+		fireAt := -1
+		if s.remain >= 0 && !s.frozen {
+			b := frm + s.remain
+			if b < to {
+				nxt = b
+				fireAt = b
+			}
+		}
+		if s.mode == smActive && s.over() && !s.frozen {
+			if s.accrueTo(frm, nxt) {
+				return
+			}
+		}
+		if s.remain >= 0 && !s.frozen {
+			s.remain -= nxt - frm
+		}
+		frm = nxt
+		if fireAt >= 0 {
+			s.fireBoundary(fireAt)
+		}
+	}
+}
+
+func (s *sim) evaluate(t int) {
+	if s.frozen {
+		return
+	}
+	over := s.over()
+	switch s.mode {
+	case smIdle:
+		if over {
+			s.mode = smArming
+			s.curStart = t
+			s.remain = s.arm
+			if s.arm == 0 {
+				s.fireBoundary(t)
+			}
+		}
+	case smArming:
+		if !over {
+			s.mode = smIdle
+			s.remain = -1
+		}
+	case smActive:
+		if !over {
+			s.mode = smReseting
+			s.resetFrom = t
+			s.remain = s.reset
+			if s.reset == 0 {
+				s.fireBoundary(t)
+			}
+		}
+	case smReseting:
+		if over {
+			s.mode = smActive
+			s.remain = -1
+		}
+	}
+}
+
+func (s *sim) onSample(t, lps int) {
+	s.curLps = lps
+	s.haveLps = true
+	if !s.frozen {
+		s.evaluate(t)
+	}
+}
