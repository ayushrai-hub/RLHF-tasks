{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReport",
  "type": "object",
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          },
          "cycle_nodes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ordering": {
            "type": "array",
            "items": { "type": "string" }
          },
          "implicit_edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" }
              },
              "required": ["from", "to"]
            }
          }
        },
        "required": ["flags", "cycle_nodes", "ordering", "implicit_edges"]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "scenarios_checked": { "type": "integer" },
        "cyclic_count": { "type": "integer" },
        "acyclic_count": { "type": "integer" },
        "signature_hash": { "type": "string" }
      },
      "required": ["scenarios_checked", "cyclic_count", "acyclic_count", "signature_hash"]
    }
  },
  "required": ["scenarios", "summary"]
}
