@@ -8,22 +8,48 @@ import "dstcron/internal/zone"
 // NextFire returns the earliest UTC second strictly after `now` at which the
 // local wall clock reads `target` seconds-of-day under zone `z`.
 //
-// It walks forward from the local day of the query: for the local day the query
-// falls on, it forms the wall-clock instant for the target time of day and, if
-// that instant is already at or before the query, advances to the next local
-// day. The local reading is converted back to UTC with the zone's conversion.
+// Candidate instants are generated for a band of local days around the query
+// under both the standard and the daylight offset; only those whose actual
+// local reading equals the target are kept, the transition instant is folded in
+// as the landing point for a target the clock skips, and the smallest candidate
+// strictly after the query is returned.
 func NextFire(z zone.Zone, now, target int64) int64 {
-	off := z.OffsetSecondsAt(now)
+	const none = int64(-1)
+	best := none
 
-	// Local day (seconds since local epoch) the query currently sits in.
-	localNow := z.ToLocal(now)
-	localMidnight := localNow - zone.Mod(localNow, zone.DaySeconds)
+	consider := func(utc int64) {
+		if utc <= now {
+			return
+		}
+		if z.LocalTimeOfDay(utc) != target {
+			return
+		}
+		if best == none || utc < best {
+			best = utc
+		}
+	}
+
+	baseDay := now/zone.DaySeconds - 2
+	for d := baseDay; d < baseDay+8; d++ {
+		localMidnight := d * zone.DaySeconds
+		consider(zone.FromLocal(localMidnight+target, z.StdSec()))
+		consider(zone.FromLocal(localMidnight+target, z.DstSec()))
+	}
 
-	localWall := localMidnight + target
-	utc := zone.FromLocal(localWall, off)
-	if utc <= now {
-		localWall += zone.DaySeconds
-		utc = zone.FromLocal(localWall, off)
+	// A target that lands in the interval the clock skips on the spring day has
+	// no genuine instant above, so the clock-advance instant is its fire.
+	gap := z.DstSec() - z.StdSec()
+	if gap > 0 && z.Spring > now {
+		localBefore := z.ToLocal(z.Spring - 1)
+		for k := int64(1); k <= gap; k++ {
+			if zone.Mod(localBefore+k, zone.DaySeconds) == target {
+				if best == none || z.Spring < best {
+					best = z.Spring
+				}
+				break
+			}
+		}
 	}
-	return utc
+
+	return best
 }
