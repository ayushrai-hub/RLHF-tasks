#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

CONTEXT_DIR = Path(os.environ.get('TOOL_CONTEXT_DIR', '/opt/tool-context'))
JIRA_PATH = CONTEXT_DIR / 'jira.jsonl'
DOCS_DIR = CONTEXT_DIR / 'docs'


def _load_jira() -> list[dict[str, object]]:
    if not JIRA_PATH.exists():
        return []
    rows: list[dict[str, object]] = []
    for line in JIRA_PATH.read_text(encoding='utf-8').splitlines():
        raw = line.strip()
        if not raw:
            continue
        rows.append(json.loads(raw))
    return rows


def _list_ids() -> list[str]:
    ids = [str(row.get('key', '')).strip() for row in _load_jira() if str(row.get('key', '')).strip()]
    if DOCS_DIR.exists():
        ids.extend(sorted(path.stem for path in DOCS_DIR.glob('*.md')))
    return sorted(dict.fromkeys(ids))


def _print_doc(doc_path: Path) -> None:
    text = doc_path.read_text(encoding='utf-8')
    sys.stdout.write(text)
    if not text.endswith('\n'):
        sys.stdout.write('\n')


def _lookup(lookup_id: str) -> int:
    target = lookup_id.strip()
    if not target:
        print('usage: context-lookup <id>', file=sys.stderr)
        return 2
    for row in _load_jira():
        if str(row.get('key', '')).strip() == target:
            print(json.dumps(row, indent=2, sort_keys=True))
            return 0
    doc_path = DOCS_DIR / f'{target}.md'
    if doc_path.exists():
        _print_doc(doc_path)
        return 0
    print(f'lookup id not found: {target}', file=sys.stderr)
    return 1


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] == 'list':
        for item in _list_ids():
            print(item)
        return 0
    if len(argv) != 2:
        print('usage: context-lookup <id> | context-lookup list', file=sys.stderr)
        return 2
    return _lookup(argv[1])


if __name__ == '__main__':
    raise SystemExit(main(sys.argv))
