#!/bin/bash
set -euo pipefail
ENV="/app/environment"
PROFILE=""
PRINC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE="$2"; shift 2 ;;
    --principal) PRINC="$2"; shift 2 ;;
    --help|-h)
      echo "usage: k7_round --profile w0_short|w0_long --principal direct|svc" >&2
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
if [[ -z "${PROFILE}" || -z "${PRINC}" ]]; then
  echo "usage: k7_round --profile w0_short|w0_long --principal direct|svc" >&2
  exit 2
fi
mkdir -p /app/work
LAUNCH="posix"
INHERIT=1
if [[ "${PRINC}" == "svc" ]]; then
  # shellcheck source=/app/environment/q8_actor/wrap_run.sh
  source "${ENV}/q8_actor/wrap_run.sh"
  wrap_ctx "${PROFILE}" >/dev/null
  LAUNCH="gnu"
  INHERIT=0
fi
exec "${ENV}/d0/h7_drv" round --profile "${PROFILE}" --principal "${PRINC}" --launch "${LAUNCH}" --inherit "${INHERIT}"
