+// State-machine modes for the per-asset excursion simulation.
+const (
+	smIdle = iota
+	smArming
+	smActive
+	smClearing
+)
+
+// sim is the per-asset excursion state machine over its (reading|service)
+// timeline. A service window freezes the arm/clear dwell and the over-time
+// budget clock; time spent frozen does not advance any of them.
+type sim struct {
+	limit, arm, clear, budget int
+	horizon                   int
+	mode                      int
+	frozen                    bool
+	haveTemp                  bool
+	curTemp                   int
+	curStart                  int
+	clearFrom                 int
+	remain                    int // non-frozen dwell seconds until the pending boundary; -1 = none
+	cum                       int
+	failed                   bool
+	failedAt                 int
+	lastEnd                   int
+	excs                      []Excursion
+}
+
+func (s *sim) over() bool { return s.haveTemp && s.curTemp > s.limit }
+
+func (s *sim) finalize(end int) {
+	if s.curStart < end {
+		s.excs = append(s.excs, Excursion{Start: s.curStart, End: end})
+	}
+	s.lastEnd = end
+}
+
+func (s *sim) accrueTo(frm, to int) bool {
+	if s.failed || to <= frm {
+		return false
+	}
+	dur := to - frm
+	if s.cum+dur >= s.budget {
+		s.failedAt = frm + (s.budget - s.cum)
+		s.cum = s.budget
+		s.failed = true
+		s.finalize(s.failedAt)
+		return true
+	}
+	s.cum += dur
+	return false
+}
+
+func (s *sim) fireBoundary(b int) {
+	if s.mode == smArming {
+		if s.over() {
+			s.mode = smActive
+			s.remain = -1
+			if s.budget == 0 {
+				s.failedAt = b
+				s.cum = 0
+				s.failed = true
+				s.finalize(b)
+			}
+		} else {
+			s.mode = smIdle
+			s.remain = -1
+		}
+	} else if s.mode == smClearing {
+		if !s.over() {
+			s.finalize(s.clearFrom)
+			s.mode = smIdle
+			s.remain = -1
+		} else {
+			s.remain = -1
+		}
+	}
+}
+
+func (s *sim) step(frm, to int) {
+	for frm < to && !s.failed {
+		nxt := to
+		fireAt := -1
+		if s.remain >= 0 && !s.frozen {
+			b := frm + s.remain
+			if b < to {
+				nxt = b
+				fireAt = b
+			}
+		}
+		if s.mode == smActive && s.over() && !s.frozen {
+			if s.accrueTo(frm, nxt) {
+				return
+			}
+		}
+		if s.remain >= 0 && !s.frozen {
+			s.remain -= nxt - frm
+		}
+		frm = nxt
+		if fireAt >= 0 {
+			s.fireBoundary(fireAt)
+		}
+	}
+}
+
+func (s *sim) evaluate(t int) {
+	if s.frozen {
+		return
+	}
+	over := s.over()
+	switch s.mode {
+	case smIdle:
+		if over {
+			s.mode = smArming
+			s.curStart = t
+			s.remain = s.arm
+			if s.arm == 0 {
+				s.fireBoundary(t)
+			}
+		}
+	case smArming:
+		if !over {
+			s.mode = smIdle
+			s.remain = -1
+		}
+	case smActive:
+		if !over {
+			s.mode = smClearing
+			s.clearFrom = t
+			s.remain = s.clear
+			if s.clear == 0 {
+				s.fireBoundary(t)
+			}
+		}
+	case smClearing:
+		if over {
+			s.mode = smActive
+			s.remain = -1
+		}
+	}
+}
+
+func (s *sim) onReading(t, temp int) {
+	s.curTemp = temp
+	s.haveTemp = true
+	if !s.frozen {
+		s.evaluate(t)
+	}
+}
