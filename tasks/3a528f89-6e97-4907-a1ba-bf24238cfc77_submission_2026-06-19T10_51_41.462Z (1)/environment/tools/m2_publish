#!/bin/bash
set -euo pipefail
OUT="/app/output/cap_audit.json"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    --help|-h)
      echo "usage: m2_publish [--out /app/output/cap_audit.json]" >&2
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
mkdir -p /app/output
exec /app/environment/d0/cap_drv emit --out "${OUT}"
