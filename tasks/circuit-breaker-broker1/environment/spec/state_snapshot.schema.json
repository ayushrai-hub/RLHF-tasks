{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CircuitBreakerBrokerStateSnapshot",
  "description": "On-disk snapshot shape for /app/state/state.json (milestone 3). Describes fields only; does not define circuit-breaker transition logic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "now_us",
    "breakers",
    "audit",
    "audit_id_counter",
    "alert_thresholds",
    "alerts",
    "alert_id_counter",
    "last_alert_at_us"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "now_us": { "type": "integer", "minimum": 0 },
    "breakers": { "type": "object" },
    "audit": { "type": "array" },
    "audit_id_counter": { "type": "integer", "minimum": 0 },
    "alert_thresholds": { "type": "object" },
    "alerts": { "type": "array" },
    "alert_id_counter": { "type": "integer", "minimum": 0 },
    "last_alert_at_us": { "type": "object" }
  }
}
