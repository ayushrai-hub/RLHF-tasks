+func (m *MembershipIndex) RebuildFromEntries(entries []model.CacheEntry) {
+	m.Reset()
+	for _, entry := range entries {
+		if entry.Revoked {
+			continue
+		}
+		member := model.GroupMember{Username: entry.Username, SubjectID: entry.SubjectID, Generation: entry.Generation}
