+pub fn phase_sequence(
+    curve: &[CurvePoint],
+    phases: &[PhaseSequencePhase],
+    start_cal_bp: f64,
+    end_cal_bp: f64,
+    step: f64,
+    min_gaps: Option<&[f64]>,
+    max_gaps: Option<&[f64]>,
+    levels: &[f64],
+) -> Result<PhaseSequenceResult> {
+    if phases.len() < 2 || phases.len() > 4 {
+        return err("invalid phase sequence count");
+    }
+    if !start_cal_bp.is_finite()
+        || !end_cal_bp.is_finite()
+        || !step.is_finite()
+        || step <= 0.0
+        || step.fract() != 0.0
+        || start_cal_bp > end_cal_bp
+    {
+        return err("invalid phase sequence grid");
+    }
+    for &level in levels {
+        if !level.is_finite() || level <= 0.0 || level > 1.0 {
+            return err("invalid HPD level");
+        }
+    }
+
+    let phase_count = phases.len();
+    let mut min_gap_bounds = vec![0.0; phase_count - 1];
+    if let Some(bounds) = min_gaps {
+        if bounds.len() != phase_count - 1 {
+            return err("invalid phase sequence minimum gap count");
+        }
+        for (idx, &bound) in bounds.iter().enumerate() {
+            if !bound.is_finite() || bound < 0.0 {
+                return err("invalid phase sequence minimum gap");
+            }
+            min_gap_bounds[idx] = bound;
+        }
+    }
+    let mut max_gap_bounds = vec![f64::INFINITY; phase_count - 1];
+    if let Some(bounds) = max_gaps {
+        if bounds.len() != phase_count - 1 {
+            return err("invalid phase sequence maximum gap count");
+        }
+        for (idx, &bound) in bounds.iter().enumerate() {
+            if !bound.is_finite() || bound < min_gap_bounds[idx] {
+                return err("invalid phase sequence maximum gap");
+            }
+            max_gap_bounds[idx] = bound;
+        }
+    }
 
+    let mut grid = Vec::new();
+    let mut x = start_cal_bp;
+    while x <= end_cal_bp + 1e-12 {
+        grid.push(x);
+        x += step;
+    }
+    if grid.is_empty() {
+        return err("empty phase sequence grid");
+    }
+    let grid_len = grid.len();
+
+    let mut candidates_by_phase = Vec::with_capacity(phase_count);
+    for phase in phases {
+        if phase.samples.is_empty() || phase.samples.len() > 8 {
+            return err("invalid phase sequence sample count");
+        }
+        let min_span = phase.min_span.unwrap_or(0.0);
+        let max_span = phase.max_span.unwrap_or(f64::INFINITY);
+        if !min_span.is_finite() || min_span < 0.0 || max_span < min_span {
+            return err("invalid phase sequence span");
+        }
+        if phase.max_span.is_some() && !max_span.is_finite() {
+            return err("invalid phase sequence span");
+        }
+
+        let mut calibrated = Vec::with_capacity(phase.samples.len());
+        for sample in &phase.samples {
+            if !sample.lab_age_bp.is_finite()
+                || !sample.lab_sigma.is_finite()
+                || sample.lab_sigma <= 0.0
+                || !sample.reservoir_age.is_finite()
+                || !sample.reservoir_sigma.is_finite()
+                || sample.reservoir_sigma < 0.0
+            {
+                return err("invalid phase sequence sample");
+            }
+            let cal = calibrate(&CalibrationInput {
+                curve: curve.to_vec(),
+                lab_age_bp: sample.lab_age_bp,
+                lab_sigma: sample.lab_sigma,
+                reservoir_age: sample.reservoir_age,
+                reservoir_sigma: sample.reservoir_sigma,
+                start_cal_bp,
+                end_cal_bp,
+                step,
+            })?;
+            if cal.points.len() != grid_len
+                || cal
+                    .points
+                    .iter()
+                    .zip(grid.iter())
+                    .any(|(point, &expected)| (point.cal_bp - expected).abs() > 1e-9)
+            {
+                return err("inconsistent phase sequence grid");
+            }
+            calibrated.push(cal);
+        }
+
+        let mut prefixes = Vec::with_capacity(calibrated.len());
+        for cal in &calibrated {
+            let mut prefix = Vec::with_capacity(grid_len + 1);
+            prefix.push(0.0);
+            for point in &cal.points {
+                prefix.push(prefix.last().unwrap() + point.probability);
+            }
+            prefixes.push(prefix);
+        }
+
+        let mut candidates = Vec::new();
+        for start_idx in 0..grid_len {
+            for end_idx in 0..=start_idx {
+                let span = grid[start_idx] - grid[end_idx];
+                if span + 1e-9 < min_span || span > max_span + 1e-9 {
+                    continue;
+                }
+                let mut weight = 1.0;
+                for prefix in &prefixes {
+                    let mass = (prefix[start_idx + 1] - prefix[end_idx]).max(0.0);
+                    weight *= mass;
+                }
+                if weight > 0.0 && weight.is_finite() {
+                    candidates.push(PhaseCandidate {
+                        start_idx,
+                        end_idx,
+                        span_idx: start_idx - end_idx,
+                        weight,
+                    });
+                }
+            }
+        }
+        if candidates.is_empty() {
+            return err("empty phase sequence candidates");
+        }
+        candidates_by_phase.push(candidates);
+    }
+
+    let mut forward: Vec<Vec<f64>> = Vec::with_capacity(phase_count);
+    forward.push(
+        candidates_by_phase[0]
+            .iter()
+            .map(|candidate| candidate.weight)
+            .collect(),
+    );
+    for phase_idx in 1..phase_count {
+        let mut by_end = vec![0.0; grid_len];
+        for (candidate, &mass) in candidates_by_phase[phase_idx - 1]
+            .iter()
+            .zip(forward[phase_idx - 1].iter())
+        {
+            by_end[candidate.end_idx] += mass;
+        }
+        let prefix = prefix_sums(&by_end);
+        let min_offset = lower_grid_offset(min_gap_bounds[phase_idx - 1], step);
+        let max_offset = upper_grid_offset(max_gap_bounds[phase_idx - 1], step, grid_len - 1);
+        let mut phase_forward = Vec::with_capacity(candidates_by_phase[phase_idx].len());
+        for candidate in &candidates_by_phase[phase_idx] {
+            let lo = candidate.start_idx.saturating_add(min_offset);
+            let hi = candidate.start_idx.saturating_add(max_offset).min(grid_len - 1);
+            let compatible = range_sum(&prefix, lo, hi);
+            phase_forward.push(candidate.weight * compatible);
+        }
+        forward.push(phase_forward);
+    }
+
+    let total: f64 = forward[phase_count - 1].iter().sum();
+    if total <= 0.0 || !total.is_finite() {
+        return err("zero phase sequence posterior");
+    }
+
+    let mut backward: Vec<Vec<f64>> = vec![Vec::new(); phase_count];
+    backward[phase_count - 1] = candidates_by_phase[phase_count - 1]
+        .iter()
+        .map(|candidate| candidate.weight)
+        .collect();
+    for phase_idx in (0..phase_count - 1).rev() {
+        let mut by_start = vec![0.0; grid_len];
+        for (candidate, &mass) in candidates_by_phase[phase_idx + 1]
+            .iter()
+            .zip(backward[phase_idx + 1].iter())
+        {
+            by_start[candidate.start_idx] += mass;
+        }
+        let prefix = prefix_sums(&by_start);
+        let min_offset = lower_grid_offset(min_gap_bounds[phase_idx], step);
+        let max_offset = upper_grid_offset(max_gap_bounds[phase_idx], step, grid_len - 1);
+        let mut phase_backward = Vec::with_capacity(candidates_by_phase[phase_idx].len());
+        for candidate in &candidates_by_phase[phase_idx] {
+            let compatible = if candidate.end_idx >= min_offset {
+                let hi = candidate.end_idx - min_offset;
+                let lo = candidate.end_idx.saturating_sub(max_offset);
+                range_sum(&prefix, lo, hi)
+            } else {
+                0.0
+            };
+            phase_backward.push(candidate.weight * compatible);
+        }
+        backward[phase_idx] = phase_backward;
+    }
+
+    let span_grid: Vec<f64> = (0..grid_len).map(|idx| idx as f64 * step).collect();
+    let mut phase_results = Vec::with_capacity(phase_count);
+    for phase_idx in 0..phase_count {
+        let mut start_probs = vec![0.0; grid_len];
+        let mut end_probs = vec![0.0; grid_len];
+        let mut span_probs = vec![0.0; grid_len];
+        for (candidate_idx, candidate) in candidates_by_phase[phase_idx].iter().enumerate() {
+            let posterior = forward[phase_idx][candidate_idx] * backward[phase_idx][candidate_idx]
+                / candidate.weight
+                / total;
+            if posterior.is_finite() && posterior > 0.0 {
+                start_probs[candidate.start_idx] += posterior;
+                end_probs[candidate.end_idx] += posterior;
+                span_probs[candidate.span_idx] += posterior;
+            }
+        }
+        phase_results.push(PhaseSequencePhaseResult {
+            phase: phase_idx,
+            start: phase_distribution_from_probs(&grid, &start_probs, levels, step, true)?,
+            end: phase_distribution_from_probs(&grid, &end_probs, levels, step, true)?,
+            span: phase_distribution_from_probs(&span_grid, &span_probs, levels, step, true)?,
+        });
+    }
+
+    let mut gap_posteriors = Vec::with_capacity(phase_count - 1);
+    for phase_idx in 0..phase_count - 1 {
+        let mut left_by_end = vec![0.0; grid_len];
+        for (candidate, &mass) in candidates_by_phase[phase_idx]
+            .iter()
+            .zip(forward[phase_idx].iter())
+        {
+            left_by_end[candidate.end_idx] += mass;
+        }
+        let mut right_by_start = vec![0.0; grid_len];
+        for (candidate, &mass) in candidates_by_phase[phase_idx + 1]
+            .iter()
+            .zip(backward[phase_idx + 1].iter())
+        {
+            right_by_start[candidate.start_idx] += mass;
+        }
+
+        let min_offset = lower_grid_offset(min_gap_bounds[phase_idx], step);
+        let max_offset = upper_grid_offset(max_gap_bounds[phase_idx], step, grid_len - 1);
+        let mut gap_probs = vec![0.0; grid_len];
+        for end_idx in 0..grid_len {
+            let left_mass = left_by_end[end_idx];
+            if left_mass <= 0.0 {
+                continue;
+            }
+            let min_start = end_idx.saturating_sub(max_offset);
+            let max_start = if end_idx >= min_offset {
+                end_idx - min_offset
+            } else {
+                continue;
+            };
+            for start_idx in min_start..=max_start {
+                let right_mass = right_by_start[start_idx];
+                if right_mass > 0.0 {
+                    gap_probs[end_idx - start_idx] += left_mass * right_mass / total;
+                }
+            }
+        }
+        gap_posteriors.push(PhaseSequenceGapResult {
+            gap: phase_idx,
+            distribution: phase_distribution_from_probs(&span_grid, &gap_probs, levels, step, true)?,
+        });
+    }
+
+    Ok(PhaseSequenceResult {
+        phases: phase_results,
+        gap_posteriors,
+    })
+}
+
+fn prefix_sums(values: &[f64]) -> Vec<f64> {
+    let mut prefix = Vec::with_capacity(values.len() + 1);
+    prefix.push(0.0);
+    for &value in values {
+        prefix.push(prefix.last().unwrap() + value);
+    }
+    prefix
+}
+
+fn range_sum(prefix: &[f64], lo: usize, hi: usize) -> f64 {
+    if prefix.len() <= 1 || lo > hi || lo >= prefix.len() - 1 {
+        return 0.0;
+    }
+    let capped_hi = hi.min(prefix.len() - 2);
+    if lo > capped_hi {
+        0.0
+    } else {
+        prefix[capped_hi + 1] - prefix[lo]
+    }
+}
+
+fn lower_grid_offset(years: f64, step: f64) -> usize {
+    if years <= 0.0 {
+        0
+    } else {
+        ((years - 1e-9) / step).ceil() as usize
+    }
+}
+
+fn upper_grid_offset(years: f64, step: f64, max_offset: usize) -> usize {
+    if years.is_infinite() {
+        max_offset
+    } else {
+        ((years + 1e-9) / step).floor().max(0.0) as usize
+    }
+}
