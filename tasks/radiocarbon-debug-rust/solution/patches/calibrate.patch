+pub fn curve_mixture_sequence(
+    models: &[CurveModel],
+    samples: &[SequenceSample],
+    start_cal_bp: f64,
+    end_cal_bp: f64,
+    step: f64,
+    min_gaps: Option<&[f64]>,
+    max_gaps: Option<&[f64]>,
+    levels: &[f64],
+) -> Result<CurveMixtureSequenceResult> {
+    if models.len() < 2 || models.len() > 5 {
+        return err("invalid curve model count");
+    }
+    if samples.len() < 2 || samples.len() > 6 {
+        return err("invalid sequence sample count");
+    }
+    if !start_cal_bp.is_finite()
+        || !end_cal_bp.is_finite()
+        || !step.is_finite()
+        || step <= 0.0
+        || step.fract() != 0.0
+        || start_cal_bp > end_cal_bp
+    {
+        return err("invalid curve mixture sequence grid");
+    }
+    for &level in levels {
+        if !level.is_finite() || level <= 0.0 || level > 1.0 {
+            return err("invalid HPD level");
+        }
+    }
 
+    let mut grid = Vec::new();
+    let mut x = start_cal_bp;
+    while x <= end_cal_bp + 1e-12 {
+        grid.push(x);
+        x += step;
+    }
+    if grid.is_empty() {
+        return err("empty curve mixture sequence grid");
+    }
+
+    let mut covered = vec![false; grid.len()];
+    for model in models {
+        for (grid_idx, &cal_bp) in grid.iter().enumerate() {
+            if interpolate(&model.curve, cal_bp).is_ok() {
+                covered[grid_idx] = true;
+            }
+        }
+    }
+    if covered.iter().any(|&item| !item) {
+        return err("uncovered curve mixture sequence grid point");
+    }
+
+    let mut prior_total = 0.0;
+    let mut per_model = Vec::with_capacity(models.len());
+    for (model_idx, model) in models.iter().enumerate() {
+        if !model.weight.is_finite() || model.weight <= 0.0 || model.curve.len() < 2 {
+            return err("invalid curve model");
+        }
+        prior_total += model.weight;
+        let seq =
+            sequence_on_mixture_grid(&model.curve, samples, &grid, step, min_gaps, max_gaps, levels)?;
+        if seq.order_probability < 0.0 || !seq.order_probability.is_finite() {
+            return err("invalid curve model order probability");
+        }
+        per_model.push((model_idx, model.weight, seq));
+    }
+    if prior_total <= 0.0 || !prior_total.is_finite() {
+        return err("invalid curve priors");
+    }
+
+    let evidence_total: f64 = per_model
+        .iter()
+        .map(|(_, weight, seq)| weight * seq.order_probability)
+        .sum();
+    if evidence_total <= 0.0 || !evidence_total.is_finite() {
+        return err("zero curve mixture sequence evidence");
+    }
+
+    let grid_len = grid.len();
+    let sample_count = samples.len();
+    let mut model_rows = Vec::with_capacity(per_model.len());
+    let mut mixed_probs = vec![vec![0.0; grid_len]; sample_count];
+
+    for (model_idx, weight, seq) in &per_model {
+        let posterior = weight * seq.order_probability / evidence_total;
+        model_rows.push([*model_idx as f64, seq.order_probability, posterior]);
+        if seq.marginals.len() != sample_count {
+            return err("inconsistent curve mixture sequence samples");
+        }
+        for (sample_idx, marginal) in seq.marginals.iter().enumerate() {
+            if marginal.calibration.points.len() != grid_len
+                || marginal
+                    .calibration
+                    .points
+                    .iter()
+                    .zip(grid.iter())
+                    .any(|(point, &expected)| (point.cal_bp - expected).abs() > 1e-9)
+            {
+                return err("inconsistent curve mixture sequence grids");
+            }
+            for (grid_idx, point) in marginal.calibration.points.iter().enumerate() {
+                mixed_probs[sample_idx][grid_idx] += posterior * point.probability;
+            }
+        }
+    }
+
+    let mut marginals = Vec::with_capacity(sample_count);
+    for sample_idx in 0..sample_count {
+        let mut points = Vec::with_capacity(grid_len);
+        let mut mean = 0.0;
+        let mut mode = grid[0];
+        let mut best = f64::NEG_INFINITY;
+        for (&cal_bp, &probability) in grid.iter().zip(mixed_probs[sample_idx].iter()) {
+            mean += cal_bp * probability;
+            if probability > best {
+                best = probability;
+                mode = cal_bp;
+            }
+            points.push(CalibrationPoint {
+                cal_bp,
+                probability,
+            });
+        }
+        let calibration = Calibration {
+            points,
+            mean_cal_bp: mean,
+            mode_cal_bp: mode,
+        };
+        let intervals = hpd(&calibration, levels, step)?;
+        marginals.push(SequenceMarginal {
+            sample: sample_idx,
+            calibration,
+            intervals,
+        });
+    }
+
+    Ok(CurveMixtureSequenceResult {
+        order_probability: evidence_total / prior_total,
+        model_order_probabilities: model_rows,
+        marginals,
+    })
+}
