+fn sequence_on_mixture_grid(
+    curve: &[CurvePoint],
+    samples: &[SequenceSample],
+    grid: &[f64],
+    step: f64,
+    min_gaps: Option<&[f64]>,
+    max_gaps: Option<&[f64]>,
+    levels: &[f64],
+) -> Result<SequenceResult> {
+    let n = samples.len();
+    let grid_len = grid.len();
+    let mut min_bounds = vec![0.0; n - 1];
+    if let Some(bounds) = min_gaps {
+        if bounds.len() != n - 1 {
+            return err("invalid sequence minimum gap count");
+        }
+        for (idx, &bound) in bounds.iter().enumerate() {
+            if !bound.is_finite() || bound < 0.0 {
+                return err("invalid sequence minimum gap");
+            }
+            min_bounds[idx] = bound;
+        }
+    }
+    let mut max_bounds = vec![f64::INFINITY; n - 1];
+    if let Some(bounds) = max_gaps {
+        if bounds.len() != n - 1 {
+            return err("invalid sequence maximum gap count");
+        }
+        for (idx, &bound) in bounds.iter().enumerate() {
+            if !bound.is_finite() || bound < min_bounds[idx] {
+                return err("invalid sequence maximum gap");
+            }
+            max_bounds[idx] = bound;
+        }
+    }
+
+    let mut probs = Vec::with_capacity(n);
+    for sample in samples {
+        if !sample.lab_age_bp.is_finite()
+            || !sample.lab_sigma.is_finite()
+            || sample.lab_sigma <= 0.0
+            || !sample.reservoir_age.is_finite()
+            || !sample.reservoir_sigma.is_finite()
+            || sample.reservoir_sigma < 0.0
+        {
+            return err("invalid sequence sample");
+        }
+        let corrected = sample.lab_age_bp - sample.reservoir_age;
+        let mut log_weights = Vec::with_capacity(grid_len);
+        let mut max_log = f64::NEG_INFINITY;
+        for &cal_bp in grid {
+            let logw = match interpolate(curve, cal_bp) {
+                Ok(c) => {
+                    let var = sample.lab_sigma * sample.lab_sigma
+                        + c.sigma * c.sigma
+                        + sample.reservoir_sigma * sample.reservoir_sigma;
+                    if var <= 0.0 || !var.is_finite() {
+                        return err("invalid sequence variance");
+                    }
+                    let diff = corrected - c.c14_bp;
+                    -0.5 * diff * diff / var - 0.5 * (2.0 * std::f64::consts::PI * var).ln()
+                }
+                Err(_) => f64::NEG_INFINITY,
+            };
+            if logw > max_log {
+                max_log = logw;
+            }
+            log_weights.push(logw);
+        }
+        if !max_log.is_finite() {
+            return err("empty curve mixture sequence model support");
+        }
+        let mut weights = Vec::with_capacity(grid_len);
+        let mut total = 0.0;
+        for &logw in &log_weights {
+            let weight = if logw.is_finite() {
+                (logw - max_log).exp()
+            } else {
+                0.0
+            };
+            total += weight;
+            weights.push(weight);
+        }
+        if total <= 0.0 || !total.is_finite() {
+            return err("invalid curve mixture sequence sample total");
+        }
+        probs.push(weights.into_iter().map(|w| w / total).collect::<Vec<_>>());
+    }
+
+    let mut left = vec![vec![0.0; grid_len]; n];
+    left[0].copy_from_slice(&probs[0]);
+    for s in 1..n {
+        for j in 0..grid_len {
+            let current_bp = grid[j];
+            let mut mass = 0.0;
+            for k in 0..grid_len {
+                let gap = grid[k] - current_bp;
+                if gap + 1e-9 >= min_bounds[s - 1] && gap <= max_bounds[s - 1] + 1e-9 {
+                    mass += left[s - 1][k];
+                }
+            }
+            left[s][j] = probs[s][j] * mass;
+        }
+    }
+
+    let mut right = vec![vec![0.0; grid_len]; n];
+    right[n - 1].copy_from_slice(&probs[n - 1]);
+    for s in (0..n - 1).rev() {
+        for j in 0..grid_len {
+            let current_bp = grid[j];
+            let mut mass = 0.0;
+            for k in 0..grid_len {
+                let gap = current_bp - grid[k];
+                if gap + 1e-9 >= min_bounds[s] && gap <= max_bounds[s] + 1e-9 {
+                    mass += right[s + 1][k];
+                }
+            }
+            right[s][j] = probs[s][j] * mass;
+        }
+    }
+
+    let total: f64 = left[n - 1].iter().sum();
+    if total < 0.0 || !total.is_finite() {
+        return err("zero order probability");
+    }
+    if total == 0.0 {
+        let mut marginals = Vec::with_capacity(n);
+        for s in 0..n {
+            let points = grid
+                .iter()
+                .map(|&cal_bp| CalibrationPoint {
+                    cal_bp,
+                    probability: 0.0,
+                })
+                .collect::<Vec<_>>();
+            let calibration = Calibration {
+                points,
+                mean_cal_bp: 0.0,
+                mode_cal_bp: grid[0],
+            };
+            let intervals = hpd(&calibration, levels, step)?;
+            marginals.push(SequenceMarginal {
+                sample: s,
+                calibration,
+                intervals,
+            });
+        }
+        return Ok(SequenceResult {
+            order_probability: 0.0,
+            marginals,
+        });
+    }
+
+    let mut marginals = Vec::with_capacity(n);
+    for s in 0..n {
+        let mut points = Vec::with_capacity(grid_len);
+        let mut mean = 0.0;
+        let mut mode = grid[0];
+        let mut best = f64::NEG_INFINITY;
+        for j in 0..grid_len {
+            let p = if probs[s][j] > 0.0 {
+                left[s][j] * right[s][j] / probs[s][j] / total
+            } else {
+                0.0
+            };
+            mean += grid[j] * p;
+            if p > best {
+                best = p;
+                mode = grid[j];
+            }
+            points.push(CalibrationPoint {
+                cal_bp: grid[j],
+                probability: p,
+            });
+        }
+        let calibration = Calibration {
+            points,
+            mean_cal_bp: mean,
+            mode_cal_bp: mode,
+        };
+        let intervals = hpd(&calibration, levels, step)?;
+        marginals.push(SequenceMarginal {
+            sample: s,
+            calibration,
+            intervals,
+        });
+    }
+
+    Ok(SequenceResult {
+        order_probability: total,
+        marginals,
+    })
+}
