# Invoked post-build to rewrite compiler dep snippets for Ninja.
if(NOT DEFINED DEPFILE_DIR)
  message(FATAL_ERROR "DEPFILE_DIR not set")
endif()
if(NOT DEFINED DEPFIX_LEGACY_MAP)
  set(DEPFIX_LEGACY_MAP FALSE)
endif()
if(NOT DEFINED DEPFIX_STRIP_GENERATED)
  set(DEPFIX_STRIP_GENERATED FALSE)
endif()
file(MAKE_DIRECTORY "${DEPFILE_DIR}")
set(_out "${DEPFILE_DIR}/${TARGET_NAME}.dep")
file(WRITE "${_out}" "# depfix normalized deps for ${TARGET_NAME}\n")

file(GLOB_RECURSE _headers "${SOURCE_DIR}/include/depfix/*.hpp")
if(DEPFIX_STRIP_GENERATED)
  list(FILTER _headers EXCLUDE REGEX "/generated/")
endif()
set(_digest_lines "")
foreach(_hdr IN LISTS _headers)
  file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_hdr}")
  if(DEPFIX_LEGACY_MAP)
    string(REPLACE "include/depfix/" "include/depfix/old/" _rel "${_rel}")
  endif()
  set(_digest_lines "${_digest_lines}${_rel}\n")
endforeach()
string(SHA256 _digest "${_digest_lines}")
list(SORT _headers)
foreach(_hdr IN LISTS _headers)
  file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_hdr}")
  if(DEPFIX_LEGACY_MAP)
    string(REPLACE "include/depfix/" "include/depfix/old/" _rel "${_rel}")
  endif()
  file(APPEND "${_out}" "${_rel}\n")
endforeach()

list(LENGTH _headers _line_count)
file(APPEND "${_out}" "# depfix-lines=${_line_count}\n")
file(APPEND "${_out}" "# depfix-digest=${_digest}\n")
