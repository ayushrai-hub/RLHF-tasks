{
  "batch_analysis": {
    "description": "Batch consistency policy per ISO/IEC 27002:2022 §8.24",
    "variance_type": "population",
    "std_deviation_formula": "sqrt(sum((x_i - mean)^2) / N)",
    "note": "Uses population std (N divisor) since all sessions are included, not a sample. Bessel's correction (N-1) would overestimate variability for complete populations.",
    "consistency_threshold": 0.25,
    "session_metric": "max_correlation_per_session"
  },
  "acceptance_criteria": {
    "batch_consistent": "std_dev < max_std_deviation",
    "outlier_detection": "none",
    "minimum_sessions": 3
  }
}
