    },
    "high": {
      "detection_threshold": 0.1,
      "min_unlinkability_score": 0.8,
      "security_level_bits": 64,
      "timing_weight": 0.25,
      "entropy_threshold": 4.0
    },
    "strict": {
      "detection_threshold": 0.05,
      "min_unlinkability_score": 0.95,
