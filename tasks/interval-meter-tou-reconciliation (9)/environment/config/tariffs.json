{
  "timezone": "America/Chicago",
  "register_max_kwh": 99999.999,
  "interval_minutes": 15,
  "demand_window_intervals": 4,
  "seasons": {
    "summer": {"start_mmdd": "06-01", "end_mmdd": "09-30"},
    "winter": {"start_mmdd": "10-01", "end_mmdd": "05-31"}
  },
  "windows": {
    "summer": {
      "off_peak": [["22:00", "06:00"]],
      "mid_peak": [["06:00", "14:00"], ["20:00", "22:00"]],
      "on_peak": [["14:00", "20:00"]]
    },
    "winter": {
      "off_peak": [["22:00", "06:00"]],
      "mid_peak": [["06:00", "16:00"], ["21:00", "22:00"]],
      "on_peak": [["16:00", "21:00"]]
    }
  }
}
