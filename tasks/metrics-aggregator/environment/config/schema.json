          "count": { "type": "integer" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "mean": { "type": "number" },
          "median": { "type": "number" },
          "stddev": { "type": "number" },
          "p95": { "type": "number" },
          "p99": { "type": "number" },
