+const remoteRoot = "testdata/remote"
+
+// isRemotePathSafe confines remote reads to the remoteRoot directory. A prefix
+// check alone is insufficient: a path like "testdata/remote/../../etc/passwd"
+// shares the prefix yet escapes the directory. Canonicalize first, then verify
+// the result stays within remoteRoot.
+func isRemotePathSafe(p string) bool {
+	if p == "" || filepath.IsAbs(p) {
+		return false
+	}
+	rel, err := filepath.Rel(remoteRoot, filepath.Clean(p))
+	if err != nil {
+		return false
+	}
+	if rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return false
+	}
+	return true
+}
