+func isScriptSafe(script string) bool {
+	badChars := []string{";", "|", "&", "`", "$", "<", ">", "\n", "\r"}
+	for _, c := range badChars {
+		if strings.Contains(script, c) {
+			return false
+		}
+	}
+	return true
+}
