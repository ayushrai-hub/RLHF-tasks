 package middleware
 
-import "errors"
+import (
+	"errors"
+)
+
+var allowedBinaries = []string{"mw-runner", "/app/environment/bin/mw-runner"}
+
+func ContainsAny(binary string, valid []string) bool {
+	for _, v := range valid {
+		if binary == v {
+			return true
+		}
+	}
+	return false
+}
 
 func FromConfig(cfg Config) (*Middleware, error) {
 	if cfg.Binary == "" {
 		return nil, errors.New("middleware_binary: missing binary")
 	}
+	if !ContainsAny(cfg.Binary, allowedBinaries) {
+		return nil, errors.New("middleware_binary: invalid binary")
+	}
 	if cfg.Mode != string(ModeLocal) && cfg.Mode != string(ModeRemote) {
 		return nil, errors.New("middleware_config: invalid mode")
 	}
