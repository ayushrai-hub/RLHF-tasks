+fn raw_audit_step(
+    acc: u64,
+    index: usize,
+    patch: &Patch,
+    committed_tag: u64,
+    rejected_tag: u64,
+    tombstone_tag: u64,
+    update_tag: u64,
+) -> u64 {
+    let mixed = acc
+        ^ ((index as u64) + 1).rotate_left(5)
+        ^ (patch.epoch as u64).rotate_left(7)
+        ^ patch.seq.rotate_left(13)
+        ^ (patch.revision as u64).rotate_left(19)
+        ^ patch.patch_id.rotate_left(31)
+        ^ (patch.lane_id as u64).rotate_left(37)
+        ^ patch.delta.rotate_right((patch.seq & 31) as u32)
+        ^ (patch.toggle_mask as u64).rotate_left(patch.revision & 31)
+        ^ if patch.committed { committed_tag } else { rejected_tag }
+        ^ if patch.kind == "tombstone" {
+            tombstone_tag
+        } else {
+            update_tag
+        };
+    mixed.rotate_left(23).wrapping_mul(0x9e37_79b9_7f4a_7c15)
+}
+
+fn raw_audit_seed(d: &Driver, seed: u64) -> u64 {
+    seed ^ (d.lane_id() as u64).rotate_left(3)
+        ^ (d.base_epoch() as u64).rotate_left(9)
+        ^ d.base_seq().rotate_left(17)
+        ^ d.base_value().rotate_right(11)
+        ^ (d.base_flags() as u64).rotate_left(29)
+}
 
+pub fn lineage_digest(d: &Driver) -> String {
+    const DIGEST_SEED: u64 = 0x3ac4_36f5_2b5d_874c;
+    const COMMITTED_TAG: u64 = 0xbb58_9c9e_e109_634b;
+    const REJECTED_TAG: u64 = 0x6d06_eef0_001d_4e1d;
+    const TOMBSTONE_AUDIT_TAG: u64 = 0x4e4b_a86b_24a1_1805;
+    const UPDATE_AUDIT_TAG: u64 = 0x59f4_5a2c_5fbe_7459;
+
+    let mut acc = raw_audit_seed(d, DIGEST_SEED);
+    for (index, patch) in d.raw().patches.iter().enumerate() {
+        acc = raw_audit_step(
+            acc,
+            index,
+            patch,
+            COMMITTED_TAG,
+            REJECTED_TAG,
+            TOMBSTONE_AUDIT_TAG,
+            UPDATE_AUDIT_TAG,
+        );
+    }
+    format!("{:016x}", acc)
+}
+
+pub fn discard_digest(d: &Driver) -> String {
+    const DIGEST_SEED: u64 = 0x350e_77b7_83bd_bb19;
+    const COMMITTED_TAG: u64 = 0x7980_7b23_1990_101e;
+    const REJECTED_TAG: u64 = 0x753e_d9c9_78ef_5fbe;
+    const TOMBSTONE_AUDIT_TAG: u64 = 0x1a0c_4eea_92d8_66dd;
+    const UPDATE_AUDIT_TAG: u64 = 0x1bf1_8c85_7f45_647a;
+
+    let active_epoch = d
+        .raw()
+        .patches
+        .iter()
+        .filter(|patch| {
+            patch.committed
+                && patch.lane_id == d.lane_id()
+                && patch.epoch >= d.base_epoch()
+                && patch.seq > d.base_seq()
+        })
+        .map(|patch| patch.epoch)
+        .max()
+        .unwrap_or(d.base_epoch());
+
+    let mut selected: BTreeMap<u64, usize> = BTreeMap::new();
+    for (index, patch) in d.raw().patches.iter().enumerate().filter(|(_, patch)| {
+        patch.committed
+            && patch.lane_id == d.lane_id()
+            && patch.epoch == active_epoch
+            && patch.seq > d.base_seq()
+    }) {
+        match selected.get(&patch.seq).copied() {
+            Some(current_index) => {
+                let current = &d.raw().patches[current_index];
+                if (patch.revision, patch.patch_id) > (current.revision, current.patch_id) {
+                    selected.insert(patch.seq, index);
+                }
+            }
+            None => {
+                selected.insert(patch.seq, index);
+            }
+        }
+    }
+
+    let winners = selected
+        .values()
+        .copied()
+        .collect::<std::collections::BTreeSet<_>>();
+    let mut acc = raw_audit_seed(d, DIGEST_SEED);
+    for (index, patch) in d.raw().patches.iter().enumerate() {
+        if winners.contains(&index) {
+            continue;
+        }
+        acc = raw_audit_step(
+            acc,
+            index,
+            patch,
+            COMMITTED_TAG,
+            REJECTED_TAG,
+            TOMBSTONE_AUDIT_TAG,
+            UPDATE_AUDIT_TAG,
+        );
+    }
+    format!("{:016x}", acc)
+}
