+func validateReceiptHeader(rf store.ReceiptFile) error {
+	r := rf.Receipt
+	if r.SchemaVersion != 1 {
+		return fmt.Errorf("%s: unsupported schema_version %d", rf.Path, r.SchemaVersion)
+	}
+	if r.BatchID == "" {
+		return fmt.Errorf("%s: empty batch_id", rf.Path)
+	}
+	if r.BatchID != store.ReceiptNameBatch(rf.Path) {
+		return fmt.Errorf("%s: receipt filename and batch_id disagree", rf.Path)
+	}
+	if r.Epoch < 0 {
+		return fmt.Errorf("%s: negative epoch", rf.Path)
+	}
+	return nil
+}
+
+func validateObjectSpec(layout store.Layout, batchID string, spec store.ObjectSpec) error {
+	if spec.LogicalKey == "" {
+		return fmt.Errorf("empty logical_key")
+	}
+	if spec.Size < 0 {
+		return fmt.Errorf("negative size")
+	}
+	if len(spec.SHA256) != 64 || strings.ToLower(spec.SHA256) != spec.SHA256 {
+		return fmt.Errorf("sha256 must be lowercase hex")
+	}
+	clean := path.Clean(spec.RelativePath)
+	if strings.HasPrefix(clean, "../") || clean == ".." || path.IsAbs(spec.RelativePath) || clean != spec.RelativePath {
+		return fmt.Errorf("relative_path must be a clean relative path")
+	}
+	prefix := "objects/" + batchID + "/"
+	if !strings.HasPrefix(spec.RelativePath, prefix) {
+		return fmt.Errorf("relative_path must stay under %s", prefix)
+	}
+	if !strings.HasSuffix(spec.RelativePath, ".dat") {
+		return fmt.Errorf("relative_path must name a .dat payload")
+	}
+	wantKey := strings.TrimSuffix(strings.TrimPrefix(spec.RelativePath, prefix), ".dat")
+	if spec.LogicalKey != wantKey {
+		return fmt.Errorf("logical_key and relative_path disagree")
+	}
+	full := layout.ObjectPath(spec.RelativePath)
+	if !strings.HasPrefix(full, layout.ObjectsDir()) {
+		return fmt.Errorf("object path escaped objects root")
+	}
+	return nil
+}
