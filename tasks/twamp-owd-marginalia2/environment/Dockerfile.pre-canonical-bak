FROM golang:1.21-bookworm@sha256:c6a5b9308b3f3095e8fde83c8bf4d68bd101fce606c1a0a1394522542509dda9

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        make=4.3-4.1 \
        ca-certificates=20230311+deb12u1 \
        python3=3.11.2-1+b1 \
        python3-pip=23.0.1+dfsg-1 \
        python3-venv=3.11.2-1+b1 \
        tmux=3.3a-3 \
        asciinema=2.2.0-1 && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages --retries 3 \
    pytest==8.4.1 \
    pytest-json-ctrf==0.3.5

WORKDIR /app

COPY app/ /app/

RUN mkdir -p /app/output /tmp/go-cache /tmp/go-path

# Surface 1: ENV for non-interactive CMD/ENTRYPOINT shells
ENV GOFLAGS=-mod=mod
ENV GOCACHE=/tmp/go-cache
ENV GOPATH=/tmp/go-path
ENV GOPROXY=off
ENV GOSUMDB=off
ENV GOTOOLCHAIN=local
ENV CGO_ENABLED=0
ENV XDG_CACHE_HOME=/tmp
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV HOME=/root
ENV PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Surface 2: symlink absolute paths under /usr/local/bin (always on minimal PATH)
RUN ln -sf /usr/local/go/bin/go /usr/local/bin/go && \
    ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

# Surface 3: /etc/profile.d for login shells (bash -lc)
RUN printf '%s\n' \
    'export PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
    'export GOCACHE=/tmp/go-cache' \
    'export GOPATH=/tmp/go-path' \
    'export GOFLAGS=-mod=mod' \
    'export GOPROXY=off' \
    'export GOSUMDB=off' \
    'export GOTOOLCHAIN=local' \
    'export CGO_ENABLED=0' \
    'export XDG_CACHE_HOME=/tmp' \
    'export HOME=${HOME:-/root}' \
    > /etc/profile.d/go.sh && chmod 0644 /etc/profile.d/go.sh

# Surface 4: /etc/bash.bashrc for interactive non-login shells (bash -c)
RUN printf '\n%s\n' \
    '# go toolchain bootstrap (twamp audit)' \
    'export PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
    'export GOCACHE=/tmp/go-cache' \
    'export GOPATH=/tmp/go-path' \
    'export GOFLAGS=-mod=mod' \
    'export GOPROXY=off' \
    'export GOSUMDB=off' \
    'export GOTOOLCHAIN=local' \
    'export CGO_ENABLED=0' \
    'export XDG_CACHE_HOME=/tmp' \
    'export HOME=${HOME:-/root}' \
    >> /etc/bash.bashrc

# Surface 5: /etc/environment for sessions that read it (cron, systemd, some PAM stacks)
RUN printf '%s\n' \
    'PATH="/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' \
    'GOCACHE="/tmp/go-cache"' \
    'GOPATH="/tmp/go-path"' \
    'GOFLAGS="-mod=mod"' \
    'GOPROXY="off"' \
    'GOSUMDB="off"' \
    'GOTOOLCHAIN="local"' \
    'CGO_ENABLED="0"' \
    'XDG_CACHE_HOME="/tmp"' \
    'HOME="/root"' \
    > /etc/environment

# Surface 6: build-time smoke test — fail the image build if any of the four
# shell contexts can't resolve `go` and run a trivial build. This catches
# every PATH-loss regression before zip.
RUN bash -lc 'which go && go version' && \
    bash  -c 'which go && go version' && \
    env -i bash -lc 'which go && go version' && \
    env -i bash  -c 'which go && go version' && \
    cd /app && go build std

# Pre-warm GOCACHE with a real compile of the (currently buggy) source
# tree. The compile output is discarded; the build artifacts populate
# /tmp/go-cache so the agent's first `make build` is dramatically
# faster (saves ~10-30 seconds of cold compile inside the 30-minute
# agent budget). The build is permitted to fail silently — only the
# warmed cache is the goal.
RUN cd /app && \
    (go build -trimpath -o /tmp/twamp-prewarm ./cmd/auditor || true) && \
    rm -f /tmp/twamp-prewarm

CMD ["/bin/bash"]
