{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "api_version",
    "rollover_epoch",
    "inventory_digest",
    "trust_anchors",
    "service_bindings",
    "drift_rows"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": { "type": "string", "const": "payments-ingress-tls/1" },
    "rollover_epoch": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "inventory_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trust_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["anchor_id", "fingerprint", "enabled", "reason"],
        "additionalProperties": false,
        "properties": {
          "anchor_id": { "type": "string" },
          "fingerprint": { "type": "string" },
          "enabled": { "type": "boolean" },
          "reason": { "type": "string", "enum": ["inventory_match", "revoked", "stale_config", "expired"] }
        }
      }
    },
    "service_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "client_ca", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "service": { "type": "string" },
          "client_ca": { "type": "string" },
          "fingerprint": { "type": "string" }
        }
      }
    },
    "drift_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "field", "config_value", "inventory_value"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string" },
          "field": { "type": "string" },
          "config_value": { "type": "string" },
          "inventory_value": { "type": "string" }
        }
      }
    }
  }
}
