{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "audit_time",
    "image_actions",
    "key_actions",
    "summary"
  ],
  "properties": {
    "audit_time": {
      "type": "string"
    },
    "image_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image_id",
          "key_id",
          "action",
          "reason"
        ],
        "properties": {
          "image_id": {
            "type": "string"
          },
          "key_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "key_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "action",
          "status"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "accept",
        "reinstate",
        "honor_exception",
        "quarantine",
        "revoke_trust"
      ],
      "properties": {
        "accept": {
          "type": "integer"
        },
        "reinstate": {
          "type": "integer"
        },
        "honor_exception": {
          "type": "integer"
        },
        "quarantine": {
          "type": "integer"
        },
        "revoke_trust": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
