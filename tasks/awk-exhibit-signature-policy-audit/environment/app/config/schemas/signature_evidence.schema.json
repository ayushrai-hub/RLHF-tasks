{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "audit_time",
    "row_count",
    "evidence"
  ],
  "properties": {
    "audit_time": {
      "type": "string"
    },
    "row_count": {
      "type": "integer"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image_id",
          "key_id",
          "algorithm",
          "verify_method",
          "computed_fingerprint",
          "fingerprint_match",
          "content_sha256",
          "signature_valid",
          "failure_reason"
        ],
        "properties": {
          "image_id": {
            "type": "string"
          },
          "key_id": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "verify_method": {
            "type": "string"
          },
          "computed_fingerprint": {
            "type": "string"
          },
          "fingerprint_match": {
            "type": "boolean"
          },
          "content_sha256": {
            "type": "string"
          },
          "signature_valid": {
            "type": "boolean"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
