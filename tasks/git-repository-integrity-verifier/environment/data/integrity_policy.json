{
  "repository_scope": {
    "metadata_file": "repository_metadata.json",
    "commit_graph_file": "commit_graph.json",
    "branch_refs_file": "branch_refs.json",
    "merge_commits_file": "merge_commits.json",
    "reflog_file": "reflog_snapshots.json",
    "tag_history_file": "tag_history.json"
  },
  "reachability": {
    "advertised_roots": ["branch_tips", "tag_peeled_commits"],
    "walk_direction": "follow_all_parents",
    "orphan_rule": "commit_in_graph_not_in_advertised_and_new_sha_in_reflog"
  },
  "orphan_classification": {
    "reflog_message_patterns": [
      {"match_substring": "amend", "reason": "amend_superseded"},
      {"match_substring": "rebase", "reason": "rebase_superseded"},
      {"match_substring": "force", "reason": "force_push_superseded"}
    ],
    "default_reason": "ref_rewrite_superseded",
    "tie_break_ref": "lexicographically_smallest_ref",
    "infer_supersession_from_same_ref": true,
    "supersession_inference": {
      "group_reflog_entries_by": "ref",
      "sort_within_ref_by": "selector_index_ascending",
      "selector_index_parse": "integer_between_@_and_closing_brace",
      "orphan_position": "entry_where_new_sha_equals_orphan_sha",
      "scan_newer_entries": "all_entries_with_lower_selector_index_on_same_ref",
      "reason_selection": "first_newer_entry_whose_message_matches_any_pattern",
      "fallback": "orphan_own_message_patterns_then_default_reason"
    }
  },
  "branch_divergence": {
    "pair_order": "lexicographic_branch_name",
    "include_self_pairs": false,
    "merge_base": "deepest_common_ancestor_all_parents",
    "fields": ["branch_a", "branch_b", "merge_base", "ahead_a", "ahead_b", "divergence_total"],
    "divergence_total_formula": "ahead_a + ahead_b"
  },
  "merge_consistency": {
    "required_parent_count": 2,
    "require_parents_in_graph": true,
    "first_parent_must_be_ancestor_of": "default_branch_tip",
    "first_parent_walk": "first_parent_only",
    "score_formula": "round_100_times_valid_over_total_merges",
    "empty_merges_score": 100.0
  },
  "graph_integrity": {
    "checks": [
      "all_parents_exist_in_graph",
      "all_branch_tips_exist_in_graph",
      "all_tag_peeled_exist_in_graph",
      "unique_commit_sha"
    ],
    "score_formula": "round_100_times_passed_over_total_checks"
  },
  "metrics_round_decimals": 1,
  "output_paths": {
    "repository_integrity_report": "/app/repository_integrity_report.md",
    "branch_divergence": "/app/branch_divergence.json",
    "orphan_commits": "/app/orphan_commits.json",
    "history_reconstruction": "/app/history_reconstruction.md"
  },
  "outputs": {
    "branch_divergence": {
      "keys": ["repository_id", "pairs"],
      "pair_entry_keys": ["branch_a", "branch_b", "merge_base", "ahead_a", "ahead_b", "divergence_total"],
      "pair_sort": ["branch_a", "branch_b"]
    },
    "orphan_commits": {
      "keys": ["repository_id", "orphans", "count"],
      "orphan_entry_keys": ["sha", "subject", "orphan_reason", "discovered_via_ref", "reflog_message"],
      "orphan_sort": ["sha"]
    },
    "repository_integrity_report": {
      "title_template": "# Repository Integrity Report — {repository_id}",
      "required_sections": [
        "Repository Summary",
        "Integrity Metrics",
        "Merge Findings",
        "Orphan Summary"
      ],
      "repository_summary_lines": {
        "repository_id": "- Repository ID: `{repository_id}`",
        "commits_in_graph": "- Commits in graph: {commit_count}",
        "active_branches": "- Active branches: {branch_count}"
      },
      "metric_line_templates": {
        "graph_integrity_score": "- graph_integrity_score: {value}",
        "merge_consistency_score": "- merge_consistency_score: {value}",
        "orphan_commit_count": "- orphan_commit_count: {count}",
        "branch_pair_count": "- branch_pair_count: {count}"
      },
      "metric_value_format": "one_decimal_place",
      "merge_findings_clean_line": "- all merge commits satisfy policy checks",
      "orphan_no_orphans_line": "- no orphan commits detected",
      "orphan_entry_line_template": "- `{sha_short}` {subject} ({orphan_reason})",
      "sha_short_length": 7
    },
    "history_reconstruction": {
      "title_template": "# History Reconstruction — {repository_id}",
      "event_sources": ["reflog_snapshots"],
      "event_sort": ["author_date", "ref", "selector"],
      "line_template": "- {author_date} {ref}: {summary}",
      "summary_from": "reflog_message"
    }
  },
  "history_event_filter": {
    "include_reflog_actions": ["commit", "merge", "cherry-pick", "rebase", "amend", "branch"],
    "exclude_substrings": ["checkout:"]
  }
}
